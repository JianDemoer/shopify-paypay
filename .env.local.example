# Admin configuration
ADMIN_CONFIG_TOKEN=change_this_token
CRON_SECRET=change_this_to_a_long_random_value

# Shopify public app installation (Shopify CLI replaces ${...} in shopify.app.toml)
SHOPIFY_API_KEY=your_shopify_app_client_id
SHOPIFY_API_SECRET=your_shopify_app_client_secret
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_OAUTH_REDIRECT_URI=https://your-app.example.com/api/auth/shopify/callback
SHOPIFY_API_SCOPES=read_products,read_orders,write_orders,write_draft_orders

# Optional fallback store config.
# Multi-store production config is managed at /admin/stores.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
CHECKOUT_PUBLIC_STORE_ID=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
SHOPIFY_APP_PROXY_SECRET=your_shopify_app_secret
SHOPIFY_ORDER_MODE=draft_order

# Optional fallback Stripe config
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_WEBHOOK_SECRET_PROD=whsec_xxx

# Optional fallback PayPal config
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Durable checkout sessions (optional; local dev falls back to .data)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHECKOUT_SESSION_DATA_DIR=.data
CHECKOUT_ACCESS_SECRET=change_this_to_a_long_random_value
CONFIG_ENCRYPTION_KEY=change_this_to_a_long_random_value
NEXT_PUBLIC_SITE_URL=https://your-store.example
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-store.example
SHOPIFY_ADMIN_API_VERSION=2025-10
# Production only: Next assets are served through the Shopify App Proxy.
# Local development intentionally ignores this value so dynamic App Router
# pages remain routable at http://127.0.0.1:3000/a/s/...
NEXT_PUBLIC_APP_PROXY_ASSET_PREFIX=/a/s
SHOPIFY_CURRENCY=USD
SHOPIFY_STANDARD_SHIPPING=3.99
SHOPIFY_EXPRESS_SHIPPING=5.99
SHOPIFY_TAX_RATE=0

# Optional fallback post-purchase upsell config
NEXT_PUBLIC_UPSELL_PRODUCT_ID=
NEXT_PUBLIC_UPSELL_VARIANT_ID=

# Product Variant IDs (get from Shopify Admin → Products → Variants)
NEXT_PUBLIC_VARIANT_PRIMARY_SIM=your_primary_sim_variant_id
NEXT_PUBLIC_VARIANT_PRIMARY_ESIM=your_primary_esim_variant_id
NEXT_PUBLIC_VARIANT_ADDON_SIM=your_addon_sim_variant_id
NEXT_PUBLIC_VARIANT_ADDON_ESIM=your_addon_esim_variant_id
