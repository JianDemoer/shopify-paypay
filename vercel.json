{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "codex/omni-checkout-app-proxy": true
    },
    "productionBranch": "codex/omni-checkout-app-proxy",
    "deploymentProtection": true
  },
  "crons": [
    { "path": "/api/cron/finalize-checkouts", "schedule": "0 2 * * *" }
  ]
}
